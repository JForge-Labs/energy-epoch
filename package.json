{
  "name": "energy-epoch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "esbuild smoke.ts --bundle --platform=node --format=esm --outfile=smoke.mjs && node smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "cap:copy": "npm run build && npx cap copy ios"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.0.0"
  },
  "description": "Energy Epoch — oil lease builder / energy ops sim",
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "pixi.js": "^8.19.0"
  }
}
